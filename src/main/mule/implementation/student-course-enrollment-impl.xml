<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="get-courseList-sub-flow" doc:id="6e5f3500-072c-4f7a-b59d-15a98c9b6b01" >
		<logger level="INFO" doc:name="sub flow started" doc:id="fdbcebce-ba05-4123-947f-33f4b1c08643" message='sub flow "get-courseList-sub-flow" started'/>
		<http:request method="GET" doc:name="Request to process layer to get course list" doc:id="382e7407-598f-4b73-9e0e-0a706c770b2e" config-ref="HTTP_Request_configuration" path="/api/coursesList" responseTimeout="#[500000]"/>
		<ee:transform doc:name="success response" doc:id="24d3c4e2-277b-4f31-959b-ea0fa09fa3ba" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  status: "success",
  message: "Courses retrieved successfully",
  totalCourses: sizeOf(payload.courses default payload),
  courses: payload.courses default payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="sub flow ended" doc:id="f981c8f5-352f-4797-8737-2241607b8a4a" message='sub flow "get-courseList-sub-flow" ended' />
	</sub-flow>
	<sub-flow name="post-student-registration-sub-flow" doc:id="9be718ec-3b80-41be-bdb9-25e7c8b3dbf6" >
		<logger level="INFO" doc:name="sub flow started" doc:id="0c3d1221-23d8-4b46-bc9b-44aa831f0c7c" message='sub flow "post-student-registration-sub-flow" started'/>
		<http:request method="GET" doc:name="Request to process layer for student registration" doc:id="df153493-1b1e-457d-8e71-b334a48a69cf" config-ref="HTTP_Request_configuration" path="/api/studentRegistration" responseTimeout="#[500000]"/>
		<ee:transform doc:name="success response" doc:id="5da0194c-8dd3-43ec-8c4b-289b047cc96a" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  status: payload.status default "success",
  message: payload.message default "Student registered successfully",
  student: payload.student default payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="sub flow ended" doc:id="b2216484-d255-4b0d-97a4-4a4bea59affa" message='sub flow "post-student-registration-sub-flow" ended' />
	</sub-flow>
	<sub-flow name="post-course-Enrollment-sub-flow" doc:id="e33d3198-0bb8-4ecb-b967-400f8c13f335" >
		<logger level="INFO" doc:name="sub flow started" doc:id="75f3eebc-4186-4935-b203-924e0da7a816" message='sub flow "post-course-Enrollment-sub-flow" started'/>
		<http:request method="POST" doc:name="Request to process layer for course enrollment" doc:id="8e92d9ed-17cc-40ab-a2f3-6848f7bb4eb9" config-ref="HTTP_Request_configuration" path="/api/courseEnrollment" responseTimeout="#[500000]"/>
		<ee:transform doc:name="success response" doc:id="349a1427-05ee-4764-8ce0-d1b4e3da9843" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  status: payload.status default "success",
  message: payload.message default "Student enrolled successfully",
  enrollment: payload.enrollment default payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="sub flow ended" doc:id="01d10955-a274-4807-84a7-e631545c0c01" message='sub flow "post-course-Enrollment-sub-flow" ended' />
	</sub-flow>
	<sub-flow name="get-list-of-students-enrolled-sub-flow" doc:id="16d043e1-2458-4fc9-a9b4-c681048e5d90" >
		<logger level="INFO" doc:name="sub - flow started" doc:id="de09faae-9db1-4968-93f5-a6718b85a8ef" message='sub flow "get-list-of-students-enrolled-sub-flow" started' />
		<http:request method="GET" doc:name="Request to process layer for getting list of students enrolled" doc:id="17010b4f-01d8-46c0-aefe-9f75a3d53aa5" config-ref="HTTP_Request_configuration" path="/api/reports/listOfStudentsEnrolled">
			<http:query-params ><![CDATA[#[{
                courseId: attributes.queryParams.courseId
            }]]]></http:query-params>
		</http:request>
		<ee:transform doc:name="success response" doc:id="5921e6ef-c1da-4da8-9f6e-1bc4e619bc96" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  status: "success",
  message: "Students retrieved successfully for course #[attributes.queryParams.courseId]",
  totalStudents: sizeOf(payload.students default payload),
  data: payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="sub - flow ended" doc:id="dbb9359f-cd41-48dd-8266-a9e6601b74d5" message='sub flow "get-list-of-students-enrolled-sub-flow" ended' />
	</sub-flow>
	<sub-flow name="get-list-of-courses-enrolled-sub-flow" doc:id="2836860a-a7a4-4452-ab82-18abe6c229ec" >
		<logger level="INFO" doc:name="sub - flow started" doc:id="6e76152e-db9e-4440-8192-ecc3d95eca5e" message='sub flow "get-courses-by-student-sub-flow" started'/>
		<http:request method="GET" doc:name="Request to process layer for getting list of courses enrolled" doc:id="634748e3-918d-4e59-b8a3-9653416554e6" config-ref="HTTP_Request_configuration" path="/api/reports/listOfCoursesEnrolled" responseTimeout="#[500000]">
			<http:query-params ><![CDATA[#[{
                studentId: attributes.queryParams.studentId
            }]]]></http:query-params>
		</http:request>
		<ee:transform doc:name="success response" doc:id="289b73f8-ad40-4406-b5b1-6549eab29923" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  status: "success",
  message: "Courses retrieved successfully for student",
  totalCourses: sizeOf(payload.courses default payload),
  data: payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="sub - flow ended" doc:id="39522002-1b00-42cc-be5b-a9aaff22f065" message='sub flow "get-courses-by-student-sub-flow" ended' />
	</sub-flow>
</mule>
